# Generates ObxdWebUiResources.cpp: every file under WEBUI_DIR as a byte array,
# served by ObxdClapPlugin through clap.webview/3 get_resource().
#
#   cmake -DWEBUI_DIR=<dir> -DOUTPUT=<file.cpp> -P EmbedWebUi.cmake
#
# Output is deterministic: files are sorted and nothing depends on the build
# machine or time.

if(NOT DEFINED WEBUI_DIR OR NOT IS_DIRECTORY "${WEBUI_DIR}")
  message(FATAL_ERROR "WEBUI_DIR must name the web editor directory")
endif()
if(NOT DEFINED OUTPUT)
  message(FATAL_ERROR "OUTPUT must name the generated source file")
endif()

file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${WEBUI_DIR}" "${WEBUI_DIR}/*")
list(SORT _files)
if(NOT _files)
  message(FATAL_ERROR "No web editor files in ${WEBUI_DIR}")
endif()

function(_mime_for path out)
  get_filename_component(_ext "${path}" LAST_EXT)
  string(TOLOWER "${_ext}" _ext)
  if(_ext STREQUAL ".html")
    set(_mime "text/html; charset=utf-8")
  elseif(_ext STREQUAL ".js" OR _ext STREQUAL ".mjs")
    set(_mime "text/javascript; charset=utf-8")
  elseif(_ext STREQUAL ".css")
    set(_mime "text/css; charset=utf-8")
  elseif(_ext STREQUAL ".svg")
    set(_mime "image/svg+xml")
  elseif(_ext STREQUAL ".png")
    set(_mime "image/png")
  elseif(_ext STREQUAL ".json")
    set(_mime "application/json")
  elseif(_ext STREQUAL ".woff2")
    set(_mime "font/woff2")
  else()
    set(_mime "application/octet-stream")
  endif()
  set(${out} "${_mime}" PARENT_SCOPE)
endfunction()

set(_body "// Generated by cmake/EmbedWebUi.cmake from webui/. Do not edit.\n")
string(APPEND _body "#include \"ObxdWebUi.h\"\n\n#include <cstring>\n\nnamespace obxd {\nnamespace {\n\n")
set(_table "")
set(_index 0)
foreach(_relative IN LISTS _files)
  file(READ "${WEBUI_DIR}/${_relative}" _hex HEX)
  string(LENGTH "${_hex}" _hex_length)
  math(EXPR _size "${_hex_length} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  # Wrap long lines so compilers and diffs stay comfortable.
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n    " _bytes "${_bytes}")
  string(APPEND _body "const unsigned char kFile${_index}[] = {\n    ${_bytes}0x00};\n\n")
  _mime_for("${_relative}" _mime)
  string(APPEND _table "    {\"/${_relative}\", \"${_mime}\", kFile${_index}, ${_size}},\n")
  math(EXPR _index "${_index} + 1")
endforeach()

string(APPEND _body "const WebUiResource kResources[] = {\n${_table}};\n\n} // namespace\n\n")
string(APPEND _body "const WebUiResource *findWebUiResource(const char *path) noexcept {\n")
string(APPEND _body "    if (!path) {\n        return nullptr;\n    }\n")
string(APPEND _body "    for (const auto &resource : kResources) {\n")
string(APPEND _body "        if (std::strcmp(resource.path, path) == 0) {\n            return &resource;\n        }\n    }\n")
string(APPEND _body "    return nullptr;\n}\n\n} // namespace obxd\n")

if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _existing)
  if(_existing STREQUAL _body)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${_body}")
